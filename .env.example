# Pfad der SQLite-Datei. Im Container liegt sie im Volume /data.
DATABASE_PATH=./data/zeiterfassung.db

# Mindestens 32 Zeichen, z. B. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Öffentliche Basis-URL der App, ohne Pfad. Lokal: http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:3000

# Zeitzone für Tages-, Wochen- und Monatsgrenzen.
APP_TIMEZONE=Europe/Berlin

# Erster Owner und seine Organisation. Werden beim Start angelegt, wenn die
# Datenbank noch keine Benutzer enthält. Danach ohne Wirkung.
BOOTSTRAP_ORGANIZATION=Mein Studio
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_NAME=Owner
BOOTSTRAP_ADMIN_PASSWORD=
